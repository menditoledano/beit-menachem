# The Apps Script web app /exec URL. Server-side only — never expose this to the
# browser, because this URL is the entire security boundary.
GAS_URL=

# Must match the SHARED_SECRET script property in the Apps Script project.
GAS_SECRET=

# Token guarding /admin.
ADMIN_TOKEN=

# Comma-separated hosts allowed to POST to the API routes.
ALLOWED_HOSTS=localhost:3000
